<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="obstacle_course">
    <include><uri>model://sun</uri></include>
    <model name="floor"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision></link></model>

    <!-- several boxes as obstacles -->
    <model name="box1"><static>true</static><link name="link"><pose>1 0 0.5 0 0 0</pose><collision name="collision"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision></link></model>
    <model name="box2"><static>true</static><link name="link"><pose>-1 1.5 0.5 0 0 0</pose><collision name="collision"><geometry><box><size>1.0 0.6 1.0</size></box></geometry></collision></link></model>
    <model name="box3"><static>true</static><link name="link"><pose>2 -1.5 0.5 0 0 0</pose><collision name="collision"><geometry><box><size>0.6 1.2 1.0</size></box></geometry></collision></link></model>
  </world>
</sdf>
