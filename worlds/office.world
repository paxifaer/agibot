<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="office">
    <include><uri>model://sun</uri></include>

    <!-- floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </visual>
      </link>
    </model>

    <!-- walls (simple box walls) -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0 5 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>0 -5 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 2</size></box></geometry></visual>
      </link>
    </model>

    <!-- a table (box) -->
    <model name="table">
      <static>true</static>
      <link name="link">
        <pose>2 1 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 1.0</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
